flowchart LR

subgraph CORE["MÓDULOS PRINCIPAIS"]
    direction TB
    campanhas["Campanhas"]
    doacoes["Doações"]
    estoque["Estoque"]
    voluntarios["Voluntários"]
    acoes["Ações"]
    impacto["Impacto"]
    comunicacao["Comunicação"]
end

subgraph FUTURO["MÓDULOS COULD HAVE"]
    direction TB
    loja["Loja"]
    mapa["Mapa"]
end

subgraph DADOS["PERSISTÊNCIA"]
    banco[("Banco de Dados")]
end

campanhas --> doacoes
campanhas --> impacto
doacoes --> impacto

estoque --> campanhas
voluntarios --> impacto
acoes --> impacto
acoes --> mapa
comunicacao --> campanhas
