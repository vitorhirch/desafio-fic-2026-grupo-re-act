class campanhas,doacoes,estoque,voluntarios,acoes,impacto,comunicacao module
class loja,mapa could
class banco database

style CORE fill:#081A10,stroke:#16A34A,stroke-width:2px,color:#BBF7D0
style FUTURO fill:#071A11,stroke:#16A34A,stroke-width:2px,color:#BBF7D0
