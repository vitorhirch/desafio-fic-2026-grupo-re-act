flowchart TB


%% =========================================================
%% ATORES
%% =========================================================

subgraph ATORES["ATORES"]
    direction LR

    visitante(["Visitante"])
    doador(["Doador"])
    voluntario(["Voluntário"])
    colaborador(["Colaborador"])
    administrador(["Administrador"])
end


%% =========================================================
%% SISTEMA
%% =========================================================

subgraph SISTEMA["PLATAFORMA"]
    direction TB


    %% =====================================================
    %% FLUXO PÚBLICO
    %% =====================================================

    subgraph FLUXO_PUBLICO["FLUXO PÚBLICO — EXPERIÊNCIA DO VISITANTE"]
        direction LR

        landing["Landing Page com Storytelling Interativo

Vulnerabilidade → Acolhimento →
Transformação → Impacto

Utilizar elementos visuais e animações durante a rolagem.
Utilizar o conceito visual de ruas e pontes.
'Percebemos muros. Criamos pontes.'"]

        campanhasAtivas["Visualizar Campanhas Ativas

Listar apenas campanhas ativas.
Exibir título, necessidade e período da campanha.
Permitir acessar os detalhes da campanha."]

        detalhesCampanha["Detalhes da Campanha

Apresentar meta e progresso atual.
Apresentar necessidades e datas de início e término.
Possibilitar ajudar/doar.
Possibilitar acesso aos pontos de coleta quando disponíveis."]

        necessidades["Necessidades Atuais

Exibir itens necessários.
Apresentar quantidade disponível e necessária quando aplicável.
Destacar itens em falta ou de maior necessidade.
Referir informações registradas pela administração."]

        landing --> campanhasAtivas
        necessidades --> campanhasAtivas
        campanhasAtivas --> detalhesCampanha
    end


    %% =====================================================
    %% FLUXO DOAÇÃO
    %% =====================================================

    subgraph FLUXO_DOACAO["FLUXO DE DOAÇÃO"]
        direction LR

        doacoesOnline["DOAÇÕES ONLINE

Permitir definir uma contribuição.
Gerar checkout/link de pagamento.
Utilizar a integração com Mercado Pago.
Direcionar o usuário de forma segura ao pagamento."]

        impacto["Exibir Impacto da Contribuição

Apresentar exemplos de impacto associados a contribuições.
Utilizar linguagem simples.
Relacionar contribuição com necessidades ou ações da ONG."]

        doacoesOnline --> impacto
    end


    %% =====================================================
    %% FLUXO VOLUNTARIADO
    %% =====================================================

    subgraph FLUXO_VOLUNTARIADO["FLUXO DE VOLUNTARIADO"]
        direction LR

        cadastrarVoluntario["Cadastrar Interesse em Voluntariado

Possuir formulário de voluntariado.
Solicitar nome, e-mail e contato.
Armazenar as informações no banco de dados."]

        visualizarVoluntarios["Visualizar e Filtrar Interessados em Voluntariado

Listar os cadastros armazenados.
Exibir informações de contato.
Exibir área de interesse e disponibilidade."]

        cadastrarVoluntario --> visualizarVoluntarios
    end


    %% =====================================================
    %% FLUXO COMUNICAÇÃO
    %% =====================================================

    subgraph FLUXO_COMUNICACAO["FLUXO DE COMUNICAÇÃO"]
        direction LR

        noticias["Visualizar Notícias e Redes Sociais

Exibir conteúdos relacionados às ações da ONG.
Exibir conteúdos vindo direto das redes sociais da ONG.
Disponibilizar acesso às redes sociais.
Possibilitar compartilhamento.
Permitir direcionamento para o Instagram."]
    end


    %% =====================================================
    %% FLUXO ADMINISTRATIVO
    %% =====================================================

    subgraph FLUXO_ADMIN["FLUXO ADMINISTRATIVO"]
        direction TB

        login["Login Administrativo

Permitir autenticação por e-mail e senha.
Impedir acesso administrativo sem autenticação.
Direcionar usuário autenticado ao painel administrativo."]

        rbac["Controle de Acesso por Função (RBAC)

Possuir diferentes perfis administrativos.
Validar permissões antes de operações restritas.
Exibir somente recursos permitidos ao perfil.
Impedir operações não autorizadas."]


        subgraph GESTAO["GESTÃO ADMINISTRATIVA"]
            direction LR

            criarCampanha["Criar / Atualizar / Acompanhar Campanha

Permitir informar título, itens/necessidade e dados definidos para doação.
Permitir informar data de início e término.
Registrar campanha no banco de dados."]

            estoque["Registrar Estoque de Itens

Selecionar o item.
Informar quantidade recebida.
Atualizar o saldo do item.
Registrar a movimentação."]

            dashboard["Dashboard Administrativo

Exibir indicador de pessoas atendidas.
Exibir número de ações.
Exibir informações de doações e voluntários.
Utilizar dados registrados na plataforma."]
        end

        login --> rbac
        rbac --> criarCampanha
        criarCampanha --> estoque
        criarCampanha --> dashboard
    end


    %% =====================================================
    %% REQUISITOS DESEJÁVEIS
    %% =====================================================

    subgraph FLUXO_FUTURO["FUNCIONALIDADES DESEJÁVEIS"]
        direction LR

        compartilhar["Compartilhar Campanha

Disponibilizar opção de compartilhamento.
Compartilhar referência para a campanha selecionada."]

        loja["LOJA DA ONG

Visualizar produtos.
Listar anúncios ativos.
Exibir informações do produto e valor.
Apresentar forma de pagamento definida."]

        mapa["MAPA DE IMPACTO

Exibir mapa de Campanhas.
Representar regiões de atuação e ações cadastradas quando aplicável.
Não expor a localização de pessoas em situação de rua."]
    end

end


%% =========================================================
%% ATORES → FLUXOS
%% =========================================================

visitante --> landing
visitante --> campanhasAtivas
visitante --> necessidades
visitante --> noticias

doador --> doacoesOnline
doador --> impacto

voluntario --> cadastrarVoluntario

colaborador --> login
administrador --> login


%% =========================================================
%% FLUXOS INTERNOS
%% =========================================================

detalhesCampanha --> doacoesOnline

estoque --> necessidades

dashboard --> impacto

noticias --> landing


%% =========================================================
%% FUTURO
%% =========================================================

campanhasAtivas -.-> compartilhar
campanhasAtivas -.-> loja
impacto -.-> mapa


%% =========================================================
%% BACKEND / API
%% =========================================================

subgraph BACKEND["BACKEND / API"]
    direction LR

    api["API DA PLATAFORMA"]

    autenticacao["Autenticação"]

    autorizacao["Autorização / RBAC"]

    regras["Regras de Negócio"]

    validacao["Validação de Dados"]

    notificacoes["Notificações"]

    api --> autenticacao
    autenticacao --> autorizacao
    autorizacao --> regras
    regras --> validacao
    regras --> notificacoes
end


%% =========================================================
%% SISTEMA → BACKEND
%% =========================================================

SISTEMA --> api


%% =========================================================
%% MÓDULOS
%% =========================================================

subgraph MODULOS["MÓDULOS DE NEGÓCIO"]
    direction LR

    moduloCampanhas["Campanhas"]
    moduloDoacoes["Doações"]
    moduloEstoque["Estoque"]
    moduloVoluntarios["Voluntários"]
    moduloAcoes["Ações"]
    moduloImpacto["Impacto"]
    moduloComunicacao["Comunicação"]
    moduloLoja["Loja"]
    moduloMapa["Mapa"]
end


%% =========================================================
%% BACKEND → MÓDULOS
%% =========================================================

regras --> MODULOS


%% =========================================================
%% RELACIONAMENTOS DOS MÓDULOS
%% =========================================================

moduloCampanhas --> moduloDoacoes
moduloCampanhas --> moduloImpacto

moduloDoacoes --> moduloImpacto

moduloEstoque --> moduloCampanhas

moduloVoluntarios --> moduloImpacto

moduloAcoes --> moduloImpacto
moduloAcoes --> moduloMapa

moduloComunicacao --> moduloCampanhas

moduloLoja -.-> moduloDoacoes


%% =========================================================
%% PERSISTÊNCIA
%% =========================================================

subgraph PERSISTENCIA["PERSISTÊNCIA"]
    direction LR

    banco[("BANCO DE DADOS")]
end

MODULOS --> banco
autorizacao --> banco


%% =========================================================
%% INTEGRAÇÕES EXTERNAS
%% =========================================================

subgraph INTEGRACOES["INTEGRAÇÕES EXTERNAS"]
    direction LR

    mercadoPago["Mercado Pago"]

    instagram["Instagram"]

    email["Serviço de E-mail"]
end


moduloDoacoes -->|"Checkout"| mercadoPago
mercadoPago -.->|"Webhook"| moduloDoacoes

moduloComunicacao -->|"Conteúdo"| instagram
instagram -.->|"Publicações"| moduloComunicacao

notificacoes --> email


