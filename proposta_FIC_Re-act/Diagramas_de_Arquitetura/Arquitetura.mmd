%% =========================================================
%% APLICAÇÃO DAS CLASSES
%% =========================================================

class visitante,doador,voluntario,colaborador,administrador actor

class landing,campanhasAtivas,detalhesCampanha,necessidades,doacoesOnline,login,rbac,criarCampanha,cadastrarVoluntario must

class noticias,dashboard,estoque,visualizarVoluntarios,impacto should

class compartilhar,loja,mapa could

class api apiStyle

class autenticacao,autorizacao,regras,validacao,notificacoes backend

class moduloCampanhas,moduloDoacoes,moduloEstoque,moduloVoluntarios,moduloAcoes,moduloImpacto,moduloComunicacao,moduloLoja,moduloMapa module

class banco database

class mercadoPago,instagram,email external


