flowchart LR

subgraph CLIENTES["CLIENTES"]
    direction TB
    publico["Site Público"]
    painel["Painel Administrativo"]
end

subgraph BACKEND["BACKEND / API"]
    direction TB
    api["API DA PLATAFORMA"]

    subgraph SEGURANCA["SEGURANÇA"]
        direction LR
        autenticacao["Autenticação"]
        autorizacao["Autorização / RBAC"]
    end

    subgraph CORE["CAMADA DE APLICAÇÃO"]
        direction LR
        validacao["Validação de Dados"]
        regras["Regras de Negócio"]
        notificacoes["Notificações"]
    end

    api --> autenticacao
    autenticacao --> autorizacao
    autorizacao --> validacao
    validacao --> regras
    regras --> notificacoes
end

subgraph DADOS["PERSISTÊNCIA"]
    banco[("Banco de Dados")]
end

subgraph EXTERNOS["INTEGRAÇÕES EXTERNAS"]
    direction TB
    mercadoPago["Mercado Pago"]
    instagram["Instagram"]
    email["Serviço de E-mail"]
end

publico --> api
painel --> api

regras --> banco
autorizacao --> banco

regras -->|"Checkout"| mercadoPago
mercadoPago -.->|"Webhook"| api

regras -->|"Conteúdo"| instagram
instagram -.->|"Publicações"| api

notificacoes --> email

classDef client fill:#111827,stroke:#64748B,stroke-width:2px,color:#F8FAFC
classDef apiStyle fill:#020617,stroke:#38BDF8,stroke-width:4px,color:#FFFFFF
classDef backend fill:#0A2115,stroke:#22C55E,stroke-width:2px,color:#DCFCE7
classDef database fill:#1B1130,stroke:#A78BFA,stroke-width:3px,color:#EDE9FE
classDef external fill:#211A06,stroke:#EAB308,stroke-width:2px,color:#FEF9C3

class publico,painel client
class api apiStyle
class autenticacao,autorizacao,validacao,regras,notificacoes backend
class banco database
class mercadoPago,instagram,email external

style CLIENTES fill:#080D18,stroke:#475569,stroke-width:2px,color:#F8FAFC
style BACKEND fill:#0A1020,stroke:#475569,stroke-width:2px,color:#E2E8F0
style SEGURANCA fill:#081A10,stroke:#16A34A,stroke-width:1px,color:#BBF7D0
style CORE fill:#081A10,stroke:#16A34A,stroke-width:1px,color:#BBF7D0
style DADOS fill:#100B1D,stroke:#7C3AED,stroke-width:2px,color:#DDD6FE
style EXTERNOS fill:#171304,stroke:#CA8A04,stroke-width:2px,color:#FEF9C3
